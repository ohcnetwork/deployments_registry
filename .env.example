# MapTiler API Key for map tiles
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key_here

# Application branding
NEXT_PUBLIC_APP_NAME=Care Deployments Registry
NEXT_PUBLIC_APP_DESCRIPTION=Global registry of deployments on an interactive map

# Organization details
NEXT_PUBLIC_ORGANIZATION_NAME=Your Organization
NEXT_PUBLIC_ORGANIZATION_URL=https://example.com
# Logo can be a local path (e.g., /logo.svg) or external URL (e.g., https://example.com/logo.svg)
NEXT_PUBLIC_ORGANIZATION_LOGO=/Open_Healthcrae_Network-light-logo.svg

# Map settings
# Set to 'true' to enable marker clustering by default, 'false' to disable
NEXT_PUBLIC_ENABLE_CLUSTERING_BY_DEFAULT=false
